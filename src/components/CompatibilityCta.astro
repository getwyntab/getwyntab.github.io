---
import { siteConfig } from '../config/site';
import { ArrowRight, Github, CheckCircle2 } from 'lucide-astro';

const browsers = [
  'Google Chrome',
  'Brave Browser',
  'Microsoft Edge',
  'Opera',
  'Vivaldi',
];
---

<section class="py-20 border-t border-[#1C1C1C] relative overflow-hidden">
  <!-- Subtle ambient glow background -->
  <div class="pointer-events-none absolute bottom-0 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-[#10B981]/10 blur-[140px] rounded-full"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative space-y-8">
    <div class="space-y-4 max-w-2xl mx-auto">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Take back your new tab today.
      </h2>
      <p class="text-neutral-400 text-base sm:text-lg">
        Free, open-source, and zero tracking. Install from the Chrome Web Store in one click.
      </p>
    </div>

    <!-- Browser Compatibility Badges -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      {browsers.map((browser) => (
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#141414] border border-[#2E2E2E] text-xs font-medium text-neutral-300">
          <CheckCircle2 class="w-3.5 h-3.5 text-[#10B981]" />
          <span>{browser}</span>
        </div>
      ))}
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a
        href={siteConfig.cwsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl font-bold text-base bg-[#10B981] hover:bg-[#34D399] text-[#022C22] shadow-xl shadow-[#10B981]/25 hover:shadow-[#10B981]/40 transition-all cursor-pointer"
      >
        <span>Install from Chrome Web Store</span>
        <ArrowRight class="w-5 h-5" />
      </a>

      <a
        href={siteConfig.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-medium text-base text-neutral-300 hover:text-white bg-[#181818] hover:bg-[#222222] border border-[#2E2E2E] transition-all"
      >
        <Github class="w-5 h-5" />
        <span>View Source on GitHub</span>
      </a>
    </div>

    <p class="text-xs text-neutral-500 font-mono">
      Apache-2.0 License • 100% Client-Side • No Telemetry
    </p>
  </div>
</section>
